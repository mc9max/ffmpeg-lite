# FFmpeg Lite — environment
# Port the API listens on (Railway proxies to this). Defaults to 8080.
PORT=8080

# Directory used for input/output files. Must match the volume mount path.
DATA_DIR=/data

# Max concurrent conversion jobs (0 = internal default).
MAX_CONCURRENT=2

# Per-job timeout in milliseconds before the process is killed. 30 min default.
JOB_TIMEOUT_MS=1800000
